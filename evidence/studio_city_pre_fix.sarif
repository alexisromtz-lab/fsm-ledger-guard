{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "fsm-ledger-guard",
          "version": "0.1.0",
          "informationUri": "https://github.com/alexisromtz-lab/fsm-ledger-guard",
          "rules": [
            {
              "id": "FSM001",
              "name": "CICLO_CON_FUGA",
              "shortDescription": {
                "text": "Ciclo con delta neto distinto de cero"
              },
              "fullDescription": {
                "text": "No existe potencial de saldo para el recurso: el ciclo puede crear o destruir unidades sin límite (pago duplicado, devolución duplicada)."
              },
              "help": {
                "text": "No existe potencial de saldo para el recurso: el ciclo puede crear o destruir unidades sin límite (pago duplicado, devolución duplicada)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM006",
              "name": "RECURSO_RETENIDO_SIN_SALIDA",
              "shortDescription": {
                "text": "Recurso que entra y no tiene arista que lo saque"
              },
              "fullDescription": {
                "text": "Dinero o cupo retenido sin reembolso ni liberación: hay una asimetría entre lo que se toma y lo que se devuelve."
              },
              "help": {
                "text": "Dinero o cupo retenido sin reembolso ni liberación: hay una asimetría entre lo que se toma y lo que se devuelve."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM008",
              "name": "MOVIMIENTO_SIN_IDEM",
              "shortDescription": {
                "text": "Transición que mueve un recurso sin clave de idempotencia"
              },
              "fullDescription": {
                "text": "Sin clave de idempotencia, el mismo evento aplicado dos veces mueve el recurso dos veces."
              },
              "help": {
                "text": "Sin clave de idempotencia, el mismo evento aplicado dos veces mueve el recurso dos veces."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM009",
              "name": "UNIDAD_INCONSISTENTE",
              "shortDescription": {
                "text": "Delta declarado en una unidad distinta a la del recurso"
              },
              "fullDescription": {
                "text": "Un mismo recurso no admite dos unidades: pesos y centavos en la misma columna desalinean todos los lectores por un factor de 100."
              },
              "help": {
                "text": "Un mismo recurso no admite dos unidades: pesos y centavos en la misma columna desalinean todos los lectores por un factor de 100."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM011",
              "name": "COTA_EXCEDIDA",
              "shortDescription": {
                "text": "Saldo por encima del máximo declarado"
              },
              "fullDescription": {
                "text": "El recurso se acumula por encima de lo que el dominio admite: la misma reserva cobrada más de una vez."
              },
              "help": {
                "text": "El recurso se acumula por encima de lo que el dominio admite: la misma reserva cobrada más de una vez."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            }
          ]
        }
      },
      "invocations": [
