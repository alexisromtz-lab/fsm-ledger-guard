          "rules": [
            {
              "id": "FSM001",
              "name": "CICLO_CON_FUGA",
              "shortDescription": {
                "text": "Ciclo con delta neto distinto de cero"
              },
              "fullDescription": {
                "text": "No existe potencial de saldo para el recurso: el ciclo puede crear o destruir unidades sin límite (pago duplicado, devolución duplicada)."
              },
              "help": {
                "text": "No existe potencial de saldo para el recurso: el ciclo puede crear o destruir unidades sin límite (pago duplicado, devolución duplicada)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM005",
              "name": "TERMINAL_CON_SALIDA",
              "shortDescription": {
                "text": "Estado declarado terminal con aristas de salida"
              },
              "fullDescription": {
                "text": "La declaración y el grafo se contradicen; una de las dos miente."
              },
              "help": {
                "text": "La declaración y el grafo se contradicen; una de las dos miente."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM008",
              "name": "MOVIMIENTO_SIN_IDEM",
              "shortDescription": {
                "text": "Transición que mueve un recurso sin clave de idempotencia"
              },
              "fullDescription": {
                "text": "Sin clave de idempotencia, el mismo evento aplicado dos veces mueve el recurso dos veces."
              },
              "help": {
                "text": "Sin clave de idempotencia, el mismo evento aplicado dos veces mueve el recurso dos veces."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM010",
              "name": "SALDO_NEGATIVO",
              "shortDescription": {
                "text": "Saldo por debajo del mínimo en una ruta alcanzable"
              },
              "fullDescription": {
                "text": "El grafo permite extraer un recurso que no se tiene."
              },
              "help": {
                "text": "El grafo permite extraer un recurso que no se tiene."
              },
              "defaultConfiguration": {
                "level": "error"
