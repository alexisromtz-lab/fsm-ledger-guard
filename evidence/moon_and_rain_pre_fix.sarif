    {
      "tool": {
        "driver": {
          "name": "fsm-ledger-guard",
          "version": "0.1.3",
          "informationUri": "https://github.com/alexisromtz-lab/fsm-ledger-guard",
          "rules": [
            {
              "id": "FSM002",
              "name": "ESTADO_INALCANZABLE",
              "shortDescription": {
                "text": "Estado inalcanzable desde el estado inicial"
              },
              "fullDescription": {
                "text": "Un estado que ninguna transición alcanza es una rama muerta del diseño."
              },
              "help": {
                "text": "Un estado que ninguna transición alcanza es una rama muerta del diseño."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM004",
              "name": "ESTADO_SIN_SALIDA",
              "shortDescription": {
                "text": "Componente sin salida y sin estado terminal"
              },
              "fullDescription": {
                "text": "Se puede entrar y no se puede salir: el trámite queda colgado."
              },
              "help": {
                "text": "Se puede entrar y no se puede salir: el trámite queda colgado."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            },
            {
              "id": "FSM006",
              "name": "RECURSO_RETENIDO_SIN_SALIDA",
              "shortDescription": {
                "text": "Recurso que entra y no tiene arista que lo saque"
              },
              "fullDescription": {
                "text": "Dinero o cupo retenido sin reembolso ni liberación: hay una asimetría entre lo que se toma y lo que se devuelve."
              },
              "help": {
                "text": "Dinero o cupo retenido sin reembolso ni liberación: hay una asimetría entre lo que se toma y lo que se devuelve."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "fsm",
                  "financial-conservation",
                  "money"
                ],
                "precision": "very-high"
              }
            }
          ]
        }
